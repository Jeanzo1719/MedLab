# Docker database variables
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=medlab-database
MARIADB_USER=medlab-database-user
MARIADB_PASSWORD=

DB_USER=medlab-database-user
DB_PASSWORD=

# Production variables (docker/prod-docker-compose.yml)
## clave que firma los tokens de sesión: al menos 32 bytes, distinta en cada entorno
MEDLAB_JWT_SECRET=
## dominio público con su esquema, separados por coma (en pruebas sin dominio: http://localhost)
SPRING_CORS_ALLOWED_ORIGINS=http://localhost
## dirección del proxy: :80 para probar sin dominio; midominio.com para HTTPS automático
SITE_ADDRESS=:80
