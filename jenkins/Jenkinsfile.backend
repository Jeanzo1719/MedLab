pipeline {
    agent any

    stages {
        stage('checkout') {
            steps {
                checkout scm
            }
        }

        stage('create environment') {
            steps {
                sh '''
                    cp .env.example .env

                    sed -i 's|^MARIADB_ROOT_PASSWORD=.*|MARIADB_ROOT_PASSWORD=root|' .env
                    sed -i 's|^MARIADB_PASSWORD=.*|MARIADB_PASSWORD=medlab|' .env
                    sed -i 's|^DB_PASSWORD=.*|DB_PASSWORD=medlab|' .env
                '''
            }
        }

        stage('docker build') {
            steps {
                sh 'docker compose --env-file .env -f docker/dev-backend-docker-compose.yml build'
            }
        }

        stage('start application') {
            steps {
                sh 'docker compose --env-file .env -f docker/dev-backend-docker-compose.yml up -d'
            }
        }

        stage('verify startup') {
            steps {
                sh 'docker compose --env-file .env -f docker/dev-backend-docker-compose.yml ps'
            }
        }
    }

    post {
        always {
            sh '''
                docker compose \
                    --env-file .env \
                    -f docker/dev-backend-docker-compose.yml \
                    down -v || true

                rm -f .env
            '''
        }
    }
}
