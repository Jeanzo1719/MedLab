pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Create Environment') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'mariadb-root-password',
                        variable: 'MARIADB_ROOT_PASSWORD'
                    ),
                    string(
                        credentialsId: 'db-password',
                        variable: 'MARIADB_PASSWORD'
                    )
                ]) {
                    sh '''
                        cp .env.example .env

                        sed -i "s|^MARIADB_ROOT_PASSWORD=.*|MARIADB_ROOT_PASSWORD=${MARIADB_ROOT_PASSWORD}|" .env
                        sed -i "s|^MARIADB_PASSWORD=.*|MARIADB_PASSWORD=${MARIADB_PASSWORD}|" .env
                        sed -i "s|^DB_PASSWORD=.*|DB_PASSWORD=${MARIADB_PASSWORD}|" .env
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker compose \
                        --env-file .env \
                        -f docker/docker-compose.yml \
                        build
                '''
            }
        }

        stage('Start Application') {
            steps {
                sh '''
                    docker compose \
                        --env-file .env \
                        -f docker/docker-compose.yml \
                        up -d
                '''
            }
        }

        stage('Verify Startup') {
            steps {
                sh '''
                    docker compose \
                        --env-file .env \
                        -f docker/docker-compose.yml \
                        ps
                '''
            }
        }
    }

    post {
        always {
            sh '''
                docker compose \
                    --env-file .env \
                    -f docker/docker-compose.yml \
                    down -v || true

                rm -f .env
            '''
        }
    }
}
